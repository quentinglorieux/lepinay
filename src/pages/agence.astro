---
import AgenceView from '../components/views/AgenceView.astro';
import { getCollection, render } from 'astro:content';

// Charger la page via la collection `pages` pour bénéficier des images `image()`
const pages = await getCollection('pages');
const entry = pages.find((p) => p.id === 'agence');
if (!entry) {
  throw new Error('Page `Agence` introuvable dans la collection `pages`.');
}

const { Content } = await render(entry);
---
<AgenceView data={entry.data}><Content /></AgenceView>
