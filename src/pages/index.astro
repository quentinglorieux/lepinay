---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Filters from '../components/Filters.vue';
import { getCollection } from 'astro:content';
const all = await getCollection('projects');
const projects = all.sort((a,b)=> Number(b?.data?.year||0) - Number(a?.data?.year||0));
---
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Agence Pierre Lépinay</title>
  </head>
  <body>
    <Header />
    <main class="container">
      <aside class="construction-notice" role="note">Site en cours de construction</aside>
      <section id="projets" style="margin:20px 0 30px">
        <Filters client:load items={projects} />
      </section>
    </main>
    <Footer />
  </body>
</html>

<style>
  .construction-notice {
    margin: 16px 0 10px;
    padding: 10px 12px;
    border: 1px solid var(--accent);
    background: var(--bg2);
    color: var(--fg);
    font-weight: 400;
    letter-spacing: 0.02em;
  }
</style>