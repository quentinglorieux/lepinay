---
import "../styles/global.css";
import SEO from '../components/SEO.astro';
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// Import direct du Markdown (composant Astro) + front matter
import Page, { frontmatter } from "../data/pages/mentions-legales.md";
---

<html lang="fr">
  <head>
    <SEO title={frontmatter.title} description={frontmatter.seo?.description} />
  </head>
  <body>
    <Header />
    <main class="container">
      <article class="prose legal">
        <header class="page-header">
          <h1>{frontmatter.title}</h1>
        </header>
        <Page />
      </article>
    </main>
    <Footer />
  </body>
</html>
