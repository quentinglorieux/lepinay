---
import ProjectView from '../../components/views/ProjectView.astro';
import { getPublished } from '../../lib/published';
import { render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getPublished('projects');
  return projects.map((p, idx) => ({
    params: { slug: p.id },
    props: {
      project: p,
      prev: idx > 0 ? projects[idx - 1] : null,
      next: idx < projects.length - 1 ? projects[idx + 1] : null,
    },
  }));
}

const { project, prev, next } = Astro.props;
const d = project.data;
const { Content } = await render(project);

// Auto-import des images si gallery vide
let gallery = d.gallery;
if (!gallery || gallery.length === 0) {
  const allImages = import.meta.glob(
    '../../data/projects/**/images/*.{png,jpg,jpeg,webp}',
    { eager: true, import: 'default' }
  );

  const folderKey = (project.id || project.slug || '').replace(/\/.+$/, '').replace(/\/$/, '');

  gallery = Object.entries(allImages)
    .filter(([path]) => folderKey && path.includes(`projects/${folderKey}/images/`))
    .map(([_, mod]) => mod);
}
---
<ProjectView data={d} gallery={gallery} prev={prev} next={next}><Content /></ProjectView>
